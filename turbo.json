{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".svelte-kit/**", ".vercel/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "migrate": {
            "cache": false
        },
        "generate": {
            "cache": false
        },
        "deploy": {
            "cache": false
        }
    }
}
