{
    "name": "musicall",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "migrate": "turbo migrate",
        "generate": "turbo generate",
        "deploy": "turbo deploy",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "turbo": "turbo"
    },
    "devDependencies": {
        "prettier": "^3.2.5",
        "turbo": "latest"
    },
    "engines": {
        "node": ">=18"
    },
    "pnpm": {
        "overrides": {
            "rollup": "4.15.0"
        }
    },
    "packageManager": "npm@10.9.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
